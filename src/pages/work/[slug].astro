---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { categories, getWorks, tc, years, href, workHref, embedUrl, stillUrl, type Work } from '../../lib/works';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work, i) => ({
    params: { slug: work.id },
    props: {
      work,
      index: i,
      total: works.length,
      prev: works[(i - 1 + works.length) % works.length],
      next: works[(i + 1) % works.length],
    },
  }));
}

interface Props {
  work: Work;
  index: number;
  total: number;
  prev: Work;
  next: Work;
}

const { work, index, total, prev, next } = Astro.props;
const d = work.data;
const embed = embedUrl(work);
const still = stillUrl(work);
const category = categories.find((c) => c.key === d.category)!.label;
const description = d.description ?? `${d.with}. ${d.role}.`;
---

<Base title={d.title} description={`${description} ${site.name}: ${d.role}.`} image={still} theme="dark">
  <nav class="bar" aria-label="Works">
    <a href={href()} data-key="index">← Index</a>
    <span class="muted">{tc(index)} / {tc(total - 1)}</span>
    <a href={workHref(next)} data-key="next" class="bar-next">Next: {next.data.title} →</a>
    <a href={workHref(prev)} data-key="prev" hidden>Previous</a>
  </nav>

  <main>
    <div class="screen">
    <div class="frame">
      {embed ? (
        <iframe
          src={embed}
          title={`${d.title} (video)`}
          loading="lazy"
          allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        />
      ) : (
        <div class="slate frame-slate">
          <span class="slate-tc">{tc(index)}</span>
          <span>{d.title}</span>
          {d.external && (
            <a class="link" href={d.external.url} target="_blank" rel="noopener">{d.external.label} ↗</a>
          )}
        </div>
      )}
    </div>

    {d.video?.protected && (
      <p class="note muted">
        This film is password-protected. <a class="link" href={`mailto:${site.email}?subject=${encodeURIComponent(`Viewing access: ${d.title}`)}`}>Ask for access</a>.
      </p>
    )}
    </div>

    <section class="credits" aria-label="Credits">
      <div class="credits-title">
        <h1>{d.title}</h1>
        <p class="muted">{years(work)} · {category}</p>
        {d.description && <p class="muted">{d.description}</p>}
      </div>
      <dl class="credits-list">
        {!d.credits && (<><dt class="muted">With</dt><dd>{d.with}</dd></>)}
        {d.credits?.map((c) => (<><dt class="muted">{c.label}</dt><dd>{c.value}</dd></>))}
        <dt class="muted">Role</dt><dd>{d.role}</dd>
        {d.links?.length && (
          <>
            <dt class="muted">Links</dt>
            <dd class="links">
              {d.links?.map((l) => <a class="link" href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>)}
            </dd>
          </>
        )}
      </dl>
    </section>
  </main>
</Base>

<style>
  :global(body.dark) {
    --paper-on-dark: #ecebe6;
    --muted: #8f8b84;   /* 5.6:1 on black */
    --red: #e0352d;     /* brighter red for the dark page, 4.9:1 */
    --trail: var(--paper-on-dark);
    background: #0d0d0c;
    color: var(--paper-on-dark);
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--gutter);
    padding: var(--s3) var(--margin);
  }
  .bar-next { justify-self: end; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }
  @media (hover: hover) { .bar a:hover { color: var(--red); } }

  main { padding: 0 var(--margin) var(--s7); }

  /* The film is as wide as the window allows while staying fully visible in height. */
  .screen { width: min(100%, calc((100svh - 140px) * 16 / 9)); margin: 0 auto; }
  .frame { aspect-ratio: 16 / 9; background: #1d1c1a; }
  .frame iframe { width: 100%; height: 100%; border: 0; display: block; }
  .frame-slate { height: 100%; padding: var(--s3) var(--s4); }
  .frame-slate .link { align-self: flex-start; }

  .note { margin-top: var(--s2); }

  .credits {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--s4);
    margin-top: var(--s5);
  }
  .credits-title { grid-column: 1 / 6; display: grid; gap: var(--s1); align-content: start; }
  .credits-title p:last-child { max-width: 48ch; }
  .credits-list {
    grid-column: 7 / 13;
    display: grid;
    grid-template-columns: 12ch 1fr;
    gap: var(--s1) var(--gutter);
  }
  .links { display: flex; gap: 2ch; flex-wrap: wrap; }

  @media (max-width: 799px) {
    .credits-title, .credits-list { grid-column: 1 / -1; }
    .credits-list { grid-template-columns: 9ch 1fr; }
  }
  @media (max-width: 599px) {
    .bar { grid-template-columns: 1fr auto; }
    .bar > span { display: none; }
    .bar-next { font-size: 0; }
    .bar-next::after { content: 'Next →'; font-size: var(--fs); }
  }
</style>

<script>
  // ← / → move between works, Esc goes back to the index.
  const keys: Record<string, string> = { ArrowLeft: 'prev', ArrowRight: 'next', Escape: 'index' };
  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const target = keys[e.key];
    if (!target) return;
    const link = document.querySelector<HTMLAnchorElement>(`.bar [data-key="${target}"]`);
    if (link) location.href = link.href;
  });
</script>
